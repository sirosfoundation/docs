# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# API specs (fetched at build time via `make fetch-api-specs`)
/static/api/

# Configuration reference docs (fetched at build time via `make fetch-config-docs`):
# the default/latest doc plus one page per tagged release, all as siblings.
# _category_.json is checked in and must not match this glob.
/docs/sirosid/reference/vc-configuration/*.md
/docs/wallet/wallet-backend-configuration/*.md
/docs/sirosid/trust/go-trust-configuration/*.md

# Release notes (fetched at build time via `make fetch-release-notes`).
# _category_.json is checked in and must not match this glob.
/docs/opensource/release-notes/*.md

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
